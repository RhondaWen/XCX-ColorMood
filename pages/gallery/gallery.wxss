/* pages/gallery/gallery.wxss */
.gallery-page {
  min-height: 100vh;
  background: #F9F5F0;
  display: flex;
  flex-direction: column;
}

.section-header {
  padding: 12px 16px;
}

.section-title {
  font-size: 18px;
  font-weight: 700;
  color: #2C2C2C;
}

.section-sub {
  font-size: 13px;
  color: #6B6B6B;
  margin-top: 4px;
}

/* 主标签栏 */
.main-tab-bar {
  display: flex;
  padding: 0 16px;
  gap: 0;
}

.main-tab {
  padding: 14px 20px;
  font-size: 16px;
  font-weight: 600;
  color: #6B6B6B;
  position: relative;
}

.main-tab.active {
  color: #F18F43;
  font-weight: 700;
}

.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: #F18F43;
  border-radius: 2px;
}

/* 子标签栏 */
.sub-tab-bar {
  display: flex;
  padding: 8px 16px;
  gap: 8px;
  border-bottom: 1px solid #D9D0C7;
}

.sub-tab {
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 500;
  color: #6B6B6B;
  border-radius: 9999px;
  background: #F0EBE3;
}

.sub-tab.active {
  color: #fff;
  background: #F18F43;
  font-weight: 600;
}

.gallery-scroll {
  flex: 1;
}

.palette-list {
  padding: 12px 16px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.palette-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.color-strip {
  height: 80px;
  display: flex;
}

.strip-item { flex: 1; }

.card-meta {
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.meta-left { flex: 1; }

.palette-name {
  font-size: 15px;
  font-weight: 700;
  color: #2C2C2C;
}

.meta-bottom {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.tag {
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 600;
}

.like-count {
  font-size: 12px;
  color: #6B6B6B;
}

.fav-btn { font-size: 20px; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  color: #6B6B6B;
  font-weight: 500;
}

.empty-tip {
  font-size: 13px;
  color: #9B9B9B;
  margin-top: 8px;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.loading-text {
  font-size: 14px;
  color: #6B6B6B;
}