<!--pages/detail/detail.wxml-->
<view class="detail-page">
  <!-- 色带 -->
  <view class="color-band">
    <block wx:for="{{palette.colors}}" wx:key="*this">
      <view class="band-item" style="background: {{item}}"></view>
    </block>
    <!-- 返回按钮 -->
    <view class="nav-back-wrap">
      <view class="nav-back" bindtap="onGoBack">←</view>
    </view>
    <!-- 名称（可编辑时显示编辑图标） -->
    <view class="band-title-row">
      <view class="band-title">{{palette.name}}</view>
      <view class="edit-name-btn" bindtap="onEditName" wx:if="{{canEdit}}">✏️</view>
    </view>
    <!-- 标签 -->
    <view class="band-tag" style="background: {{palette.emotionColor || '#F18F43'}}22; color: {{palette.emotionColor || '#F18F43'}}">{{palette.emotionTag}}</view>
  </view>

  <!-- 颜色详情 -->
  <scroll-view scroll-y class="detail-scroll">
    <view class="detail-body">
      <!-- 颜色列表 -->
      <view class="color-list-section">
        <view class="section-title">颜色详情</view>
        <block wx:for="{{colorDetails}}" wx:key="hex">
          <view
            class="color-row"
            data-color="{{item.hex}}"
            bindtap="onCopyColor"
          >
            <view class="color-dot" style="background: {{item.hex}}"></view>
            <view class="color-info">
              <view class="color-name">{{item.name}}</view>
              <view class="color-hex">{{item.hex}}</view>
            </view>
            <view class="copy-btn">复制</view>
          </view>
        </block>
      </view>

      <!-- 描述 -->
      <view class="detail-desc" wx:if="{{palette.description}}">
        {{palette.description}}
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="detail-actions">
      <button class="btn-ghost" bindtap="onSaveImage">保存图片</button>
      <button class="btn-danger" bindtap="onDelete" wx:if="{{canEdit}}">删除色卡</button>
    </view>
  </scroll-view>

  <!-- 隐藏的 Canvas 用于生成图片 -->
  <canvas type="2d" id="paletteCanvas" canvas-id="paletteCanvas" style="width: 300px; height: 400px; position: fixed; left: -9999px; top: -9999px;"></canvas>
</view>