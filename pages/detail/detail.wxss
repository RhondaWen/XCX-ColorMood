/* pages/detail/detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #F9F5F0;
  display: flex;
  flex-direction: column;
}

/* 色带 */
.color-band {
  height: 160px;
  display: flex;
  position: relative;
  flex-shrink: 0;
}

.band-item {
  flex: 1;
}

.nav-back-wrap {
  position: absolute;
  top: 16px;
  left: 16px;
}

.nav-back {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #2C2C2C;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
}

.band-title {
  position: absolute;
  bottom: 12px;
  left: 16px;
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1px 4px rgba(0,0,0,0.2);
}

/* 颜色详情 */
.detail-scroll {
  flex: 1;
}

.detail-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.color-row {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 12px;
  padding: 8px 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.color-dot {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  flex-shrink: 0;
}

.color-info {
  flex: 1;
}

.color-name {
  font-size: 14px;
  font-weight: 600;
  color: #2C2C2C;
}

.color-hex {
  font-size: 12px;
  color: #6B6B6B;
  margin-top: 2px;
}

.tag {
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 600;
  margin-right: 6px;
}

.copy-btn {
  background: #F0EBE3;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 11px;
  color: #6B6B6B;
}

.detail-desc {
  background: #F3EFFA;
  border-radius: 12px;
  padding: 12px;
  font-size: 13px;
  color: #6B6B6B;
  font-style: italic;
  line-height: 1.7;
  border-left: 3px solid #C9B8E8;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 12px;
  padding: 0 16px 32px;
}

.btn-primary {
  flex: 1;
  height: 44px;
  background: #F18F43;
  color: #fff;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  flex: 1;
  height: 44px;
  background: transparent;
  color: #6B6B6B;
  border: 1.5px solid #D9D0C7;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
}

.btn-ghost::after {
  border: none;
}