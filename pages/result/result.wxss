/* pages/result/result.wxss */
.result-page {
  min-height: 100vh;
  background: #F9F5F0;
  display: flex;
  flex-direction: column;
}

/* Header */
.result-header {
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.nav-back {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #2C2C2C;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
}

.header-info {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.emotion-icon-wrap {
  width: 40px;
  height: 40px;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.emotion-icon {
  font-size: 24px;
}

.emotion-name {
  font-size: 20px;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: -0.5px;
}

.emotion-sub {
  font-size: 12px;
  color: #6B6B6B;
  margin-top: 2px;
}

/* 色板列表 */
.palette-scroll {
  flex: 1;
}

.palette-list {
  padding: 0 16px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.palette-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.color-strip {
  height: 80px;
  display: flex;
}

.strip-item {
  flex: 1;
}

.card-meta {
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.meta-left {
  flex: 1;
}

.palette-name {
  font-size: 15px;
  font-weight: 700;
  color: #2C2C2C;
}

.meta-bottom {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.tag {
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 600;
}

.like-count {
  font-size: 12px;
  color: #6B6B6B;
}

.fav-btn {
  font-size: 20px;
}

/* 底部操作栏 */
.bottom-bar {
  padding: 12px 16px;
  background: #fff;
  border-top: 1px solid #D9D0C7;
  flex-shrink: 0;
}

.btn-secondary {
  width: 100%;
  height: 44px;
  background: transparent;
  color: #94B276;
  border: 1.5px solid #94B276;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 600;
}

.btn-secondary::after {
  border: none;
}