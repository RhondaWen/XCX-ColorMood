/* pages/home/home.wxss */
.home-page {
  min-height: 100vh;
  background: #F9F5F0;
  padding-bottom: 20px;
}

/* Header */
.home-header {
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.greeting-wrap {
  flex: 1;
}

.greeting {
  font-size: 22px;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: -0.5px;
}

.greeting .highlight {
  color: #F18F43;
}

.greeting-sub {
  font-size: 12px;
  color: #6B6B6B;
  margin-top: 4px;
}

.avatar {
  width: 38px;
  height: 38px;
  background: #C9B8E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

/* 情绪网格 */
.emotion-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 0 16px;
}

.emotion-card {
  border-radius: 16px;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
}

.emotion-card::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.12;
  background: var(--card-color, transparent);
}

.emotion-card:active {
  transform: scale(0.97);
}

.emotion-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  position: relative;
  z-index: 1;
}

.emotion-name {
  font-size: 16px;
  font-weight: 700;
  color: #2C2C2C;
  margin-top: 8px;
  position: relative;
  z-index: 1;
}

.emotion-name-en {
  font-size: 11px;
  color: #6B6B6B;
  letter-spacing: 0.5px;
  position: relative;
  z-index: 1;
}

.emotion-desc {
  font-size: 11px;
  color: #6B6B6B;
  text-align: center;
  margin-top: 6px;
  position: relative;
  z-index: 1;
}

/* 每日打卡 */
.checkin-bar {
  margin: 16px 16px 0;
  background: linear-gradient(135deg, #F18F43 0%, #F5A660 100%);
  border-radius: 16px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4px 16px rgba(241,143,67,0.3);
}

.checkin-info {
  flex: 1;
}

.checkin-label {
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.checkin-sub {
  color: rgba(255,255,255,0.75);
  font-size: 11px;
  margin-top: 2px;
}

.checkin-arrow {
  color: #fff;
  font-size: 20px;
}