/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: #F9F5F0;
  display: flex;
  flex-direction: column;
}

/* Hero区域 */
.login-hero {
  height: 240px;
  background: linear-gradient(160deg, #C9B8E8 0%, #F9F5F0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.login-hero::before {
  content: '';
  position: absolute;
  width: 200px;
  height: 200px;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  top: -60px;
  right: -60px;
}

.emoji-row {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.emoji-item {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.logo-text {
  font-size: 30px;
  font-weight: 700;
  color: #2C2C2C;
  letter-spacing: -1px;
}

.logo-highlight {
  color: #F18F43;
}

.slogan {
  font-size: 13px;
  color: #6B6B6B;
  letter-spacing: 1.5px;
  margin-top: 8px;
}

/* 表单区域 */
.login-form {
  flex: 1;
  background: #F9F5F0;
  border-radius: 24px 24px 0 0;
  margin-top: -20px;
  padding: 32px 16px 16px;
}

.form-title {
  font-size: 22px;
  font-weight: 700;
  color: #2C2C2C;
  margin-bottom: 6px;
}

.form-subtitle {
  font-size: 13px;
  color: #6B6B6B;
  margin-bottom: 24px;
}

.input-group {
  margin-bottom: 16px;
}

.input-label {
  font-size: 12px;
  color: #6B6B6B;
  margin-bottom: 8px;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 44px;
  background: #F0EBE3;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #2C2C2C;
}

.input-field::placeholder {
  color: #C8C0B8;
}

.btn-primary {
  width: 100%;
  height: 44px;
  background: #F18F43;
  color: #fff;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 600;
  margin-top: 16px;
  border: none;
}

.btn-primary::after {
  border: none;
}

.skip-login {
  text-align: center;
  margin-top: 12px;
}

.skip-text {
  font-size: 13px;
  color: #C9B8E8;
}

.form-links {
  display: flex;
  justify-content: center;
  margin-top: 16px;
}

.link-text {
  font-size: 13px;
  color: #6B6B6B;
}

.link-highlight {
  color: #F18F43;
  font-weight: 600;
}