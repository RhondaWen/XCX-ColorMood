/* pages/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
  background: #F9F5F0;
  padding-bottom: 32px;
}

/* 头像区域 */
.avatar-section {
  padding: 32px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  position: relative;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 48px;
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.4);
  color: #fff;
  font-size: 12px;
  padding: 4px 0;
  text-align: center;
}

.avatar-tip {
  font-size: 13px;
  color: #6B6B6B;
  margin-top: 12px;
}

/* 表单区域 */
.form-section {
  padding: 0 16px;
}

.form-card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #F0EBE3;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 80px;
  font-size: 15px;
  font-weight: 600;
  color: #2C2C2C;
}

.form-input {
  flex: 1;
  font-size: 14px;
  color: #2C2C2C;
  text-align: right;
}

.form-tip {
  font-size: 12px;
  color: #9B9B9B;
  margin-top: 12px;
  text-align: center;
}

/* 保存按钮 */
.save-section {
  padding: 24px 16px;
}

.save-btn {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #F18F43 0%, #F5B971 100%);
  color: #fff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 600;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn.disabled {
  opacity: 0.6;
}