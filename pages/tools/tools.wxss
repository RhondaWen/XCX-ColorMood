/* pages/tools/tools.wxss */
.tools-page {
  min-height: 100vh;
  background: #F9F5F0;
  padding-bottom: 32px;
}

.section-header {
  padding: 12px 16px;
}

.section-title {
  font-size: 18px;
  font-weight: 700;
  color: #2C2C2C;
}

.section-sub {
  font-size: 13px;
  color: #6B6B6B;
  margin-top: 4px;
}

.shake-card {
  margin: 0 16px 12px;
  background: linear-gradient(135deg, #C9B8E8 0%, #F3EFFA 100%);
  border-radius: 16px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.shake-icon {
  font-size: 36px;
  animation: shake 2s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

.shake-text { flex: 1; }
.shake-title { font-size: 15px; font-weight: 700; color: #2C2C2C; }
.shake-desc { font-size: 12px; color: #6B6B6B; margin-top: 3px; }
.shake-arrow { font-size: 20px; color: #6B6B6B; }

.generator-card {
  margin: 0 16px 12px;
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.gen-title {
  font-size: 16px;
  font-weight: 700;
  color: #2C2C2C;
  margin-bottom: 12px;
}

/* 拍照取色色卡区域 */
.photo-color-section {
  margin: 0 16px 12px;
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.photo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.photo-title {
  font-size: 16px;
  font-weight: 700;
  color: #2C2C2C;
}

.photo-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #6B6B6B;
  background: #F0EBE3;
  border-radius: 50%;
}

.photo-desc {
  font-size: 12px;
  color: #6B6B6B;
  margin-bottom: 12px;
}

.color-strip-card {
  background: #F9F5F0;
  border-radius: 12px;
  overflow: hidden;
}

/* 色条 */
.color-strip {
  height: 60px;
  display: flex;
}

.strip-item {
  flex: 1;
}

.strip-item:active {
  opacity: 0.85;
}

.strip-meta {
  padding: 12px;
}

.color-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.color-info-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.color-info-item:active {
  opacity: 0.7;
}

.color-dot {
  width: 24px;
  height: 24px;
  border-radius: 6px;
}

.color-text {
  flex: 1;
}

.color-hex {
  font-size: 13px;
  font-weight: 600;
  color: #2C2C2C;
}

.color-name {
  font-size: 11px;
  color: #6B6B6B;
}

.color-ratio {
  font-size: 12px;
  color: #F18F43;
  font-weight: 500;
}

/* 保存色卡按钮 */
.save-card-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 16px;
  padding: 12px;
  background: linear-gradient(135deg, #F18F43 0%, #F5B971 100%);
  border-radius: 12px;
}

.save-card-btn:active {
  opacity: 0.85;
}

.save-icon {
  font-size: 18px;
}

.save-text {
  font-size: 15px;
  font-weight: 600;
  color: #fff;
}

.color-input-row {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.color-swatch {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}

.picker-inner { width: 100%; height: 100%; }

.hex-input {
  flex: 1;
  height: 44px;
  background: #F0EBE3;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  color: #2C2C2C;
}

.mode-btns {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.mode-btn {
  padding: 5px 12px;
  border-radius: 9999px;
  border: 1.5px solid #D9D0C7;
  background: transparent;
  font-size: 12px;
  color: #6B6B6B;
}

.mode-btn.active {
  border-color: #F18F43;
  background: #FEF0E3;
  color: #F18F43;
  font-weight: 600;
}

.gen-result { display: flex; gap: 8px; }

.color-chip {
  flex: 1;
  height: 60px;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 6px;
}

.chip-hex {
  font-size: 10px;
  color: #fff;
  background: rgba(0,0,0,0.2);
  padding: 2px 6px;
  border-radius: 4px;
}

.tools-header {
  padding: 0 16px 8px;
  font-size: 16px;
  font-weight: 700;
  color: #2C2C2C;
}

.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 0 16px;
}

.tool-card {
  background: #F0EBE3;
  border-radius: 16px;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.tool-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.tool-name { font-size: 15px; font-weight: 700; color: #2C2C2C; }
.tool-desc { font-size: 11px; color: #6B6B6B; line-height: 1.5; }