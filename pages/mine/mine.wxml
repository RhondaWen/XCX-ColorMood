<!--pages/mine/mine.wxml-->
<view class="mine-page">
  <!-- Hero -->
  <view class="mine-hero">
    <view class="hero-avatar">{{userInfo.avatar || '🌸'}}</view>
    <view class="hero-name">{{userInfo.username || '用户'}}</view>
    <view class="hero-stats">
      <view class="stat-item">
        <view class="stat-num" style="color: #F18F43">{{checkinDays}}</view>
        <view class="stat-label">打卡天数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num" style="color: #94B276">{{favoritesCount}}</view>
        <view class="stat-label">已收藏</view>
      </view>
    </view>
  </view>

  <!-- 情绪色历 -->
  <view class="calendar-section">
    <view class="calendar-header">
      <view class="calendar-month">{{currentMonth}}</view>
      <view class="calendar-nav">
        <view class="nav-btn" bindtap="onPrevMonth">‹</view>
        <view class="nav-btn" bindtap="onNextMonth">›</view>
      </view>
    </view>
    <view class="calendar-weekdays">
      <view class="weekday">日</view>
      <view class="weekday">一</view>
      <view class="weekday">二</view>
      <view class="weekday">三</view>
      <view class="weekday">四</view>
      <view class="weekday">五</view>
      <view class="weekday">六</view>
    </view>
    <view class="calendar-grid">
      <block wx:for="{{calendarData}}" wx:key="index">
        <view
          class="cal-day {{item.empty ? 'empty' : ''}} {{item.today ? 'today' : ''}}"
          style="{{!item.empty ? 'background: ' + item.color + '; opacity: ' + (item.checked ? '1' : '0.4') + '; color: ' + (item.checked ? '#fff' : '#aaa') : ''}}"
          data-day="{{item.day}}"
          data-checked="{{item.checked}}"
          bindtap="onCalendarDay"
        >{{item.day}}</view>
      </block>
    </view>
    <view class="calendar-legend">
      <view class="legend-item">
        <view class="legend-dot" style="background: #E8B4B8"></view>
        <view class="legend-text">温柔</view>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background: #F18F43"></view>
        <view class="legend-text">活力</view>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background: #94B276"></view>
        <view class="legend-text">沉静</view>
      </view>
      <view class="legend-item">
        <view class="legend-dot" style="background: #9B8EA8"></view>
        <view class="legend-text">忧郁</view>
      </view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="favorites-section">
    <view class="favorites-header">
      <view class="favorites-title">我的收藏</view>
      <view class="favorites-more" bindtap="onViewAllFavorites">查看全部 →</view>
    </view>
    <scroll-view scroll-x class="favorites-scroll">
      <block wx:for="{{favorites}}" wx:key="id">
        <view class="fav-card" data-id="{{item.id}}" bindtap="onFavoriteDetail">
          <view class="fav-strip">
            <block wx:for="{{item.colors}}" wx:for-item="color" wx:key="*this">
              <view class="fav-strip-item" style="background: {{color}}"></view>
            </block>
          </view>
          <view class="fav-name">{{item.name}}</view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 菜单 -->
  <view class="mine-menu">
    <view class="menu-item" bindtap="onGoProfile">
      <view class="menu-left">
        <view class="menu-icon">👤</view>
        <view class="menu-text">个人信息</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onViewAllFavorites">
      <view class="menu-left">
        <view class="menu-icon">📅</view>
        <view class="menu-text">情绪色历</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <view class="menu-left">
        <view class="menu-icon">ℹ️</view>
        <view class="menu-text">关于情绪色谱</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>