/* components/color-card/color-card.wxss */
.color-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #fff;
  border-radius: 12px;
  padding: 8px 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.color-dot {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  flex-shrink: 0;
}

.color-info { flex: 1; }

.color-name {
  font-size: 14px;
  font-weight: 600;
  color: #2C2C2C;
}

.color-hex {
  font-size: 12px;
  color: #6B6B6B;
  margin-top: 2px;
}

.tag {
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 600;
  margin-right: 6px;
}

.copy-btn {
  background: #F0EBE3;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 11px;
  color: #6B6B6B;
}