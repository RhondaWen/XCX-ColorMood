/* components/color-picker-panel/color-picker-panel.wxss */

/* 颜色选择面板 */
.color-picker-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24px 24px 0 0;
  padding: 20px;
}

.palette-scroll {
  max-height: 35vh;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.panel-title {
  font-size: 18px;
  font-weight: 600;
  color: #2C2C2C;
}

.panel-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #6B6B6B;
}

/* HEX 输入区域 */
.hex-input-section {
  margin-bottom: 16px;
}

.hex-label {
  font-size: 14px;
  color: #6B6B6B;
  margin-bottom: 8px;
}

.hex-input-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hex-input {
  flex: 1;
  height: 44px;
  background: #F9F5F0;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 16px;
  font-family: monospace;
}

.hex-picker-btn {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  border: 2px solid #D9D0C7;
}

.hex-hint {
  font-size: 12px;
  color: #E8B4B8;
  margin-top: 6px;
}

/* 当前颜色预览 */
.current-color-preview {
  height: 60px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.current-color-hex {
  font-size: 14px;
  color: #fff;
  background: rgba(0,0,0,0.3);
  padding: 4px 12px;
  border-radius: 6px;
}

/* 颜色分类 */
.palette-section {
  margin-bottom: 16px;
}

.palette-label {
  font-size: 12px;
  color: #6B6B6B;
  margin-bottom: 8px;
}

.palette-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.palette-dot {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid transparent;
  flex-shrink: 0;
}

.palette-dot.active {
  border-color: #2C2C2C;
  transform: scale(1.1);
}

/* 确认按钮 */
.panel-footer {
  margin-top: 16px;
}

.btn-confirm {
  width: 100%;
  height: 44px;
  color: #fff;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 600;
  border: none;
}

.btn-confirm::after {
  border: none;
}